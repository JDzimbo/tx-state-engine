# Copy this file to .env and fill in your own values.
# Never commit .env — it's in .gitignore.

PORT=3000

# Postgres connection string.
# For Supabase: Dashboard → Connect → Session pooler → copy the URI.
# Replace [YOUR-PASSWORD] with your actual database password.
# Append ?sslmode=require at the end.
#
# Special characters in your password must be URL-encoded:
#   @  →  %40
#   :  →  %3A
#   /  →  %2F
#   #  →  %23
#   ?  →  %3F
#   &  →  %26
#   %  →  %25
#
# Example (with fake credentials):
# DATABASE_URL=postgresql://postgres.abcdefghijkl:yourpassword@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

DATABASE_URL=